<nav class="BREADCRUMBS" aria-label="breadcrumbs">
  <ul>
    {{! A persistent Home root on every trail. On the home page itself this is }}
    {{! the only (and current) crumb, so it is rendered as plain text. }}
    <li>
      {{~#if page.home~}}
        Home
      {{~else~}}
        <a href="{{{relativize '/'}}}">Home</a>
      {{~/if~}}
    </li>
    {{#unless page.home}}
      {{#each page.breadcrumbs}}
        <li>
          {{~#if (and ./url (eq ./urlType 'internal'))~}}
            <a href="{{{relativize ./url}}}">{{{./content}}}</a>
          {{~else~}}
            {{{./content}}}
          {{~/if~}}
        </li>
      {{/each}}
    {{/unless}}
  </ul>
</nav>
